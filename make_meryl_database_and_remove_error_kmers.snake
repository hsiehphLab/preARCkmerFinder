import sys
import os
import re


# note: errror is deliberately misspelled to enable easy searching for the real thing

configfile: "config.yaml"


wildcard_constraints:
    # Restrict the value of {szDatasetName} to exclude periods globally
    szDatasetName = "[^.]+"
    
def aGetAllDatasetNames():
	aDatasets = []
	with open( config["manifest"], "r" ) as fManifest:
		for szLine in fManifest.readlines():
			# looks like:
			# dataset: (dataset)
			# archaic: Y/N
			# reads: (path to reads)
			szLine = szLine.rstrip()
			if ( szLine == "" ):
				continue
			if( szLine.startswith( "#" ) ):
				continue
            
			aWords = szLine.split()
			if ( aWords[0] == "dataset:" ):
				aDatasets.append( aWords[1] )

	return aDatasets


def szGetShortReadDataSetByDatasetName( wildcards ):
	nLookingForDataset = 1
	nLookingForReads = 2

	nState = nLookingForDataset


	with open( config["manifest"], "r" ) as fManifest:
		for szLine in fManifest.readlines():
			szLine = szLine.rstrip()
			if ( szLine == "" ):
				continue
			if ( szLine.startswith( "#" ) ):
				continue
			# looks like:
			# dataset: (dataset)
			# archaic: Y/N
			# reads: (path to reads)
			aWords = szLine.split()
			if ( ( nState == nLookingForDataset ) and \
                ( aWords[0] == "dataset:" ) and ( aWords[1] == wildcards.szDatasetName ) ):
				nState = nLookingForReads
			elif( nState == nLookingForReads ):
				if ( aWords[0] == "reads:" ):
					return aWords[1]

	exit( "was looking for {wildcards.szDatasetName} in " + config["manifest"] + " but couldn't find it" )





rule make_all_meryl_databases:
	input: expand( config["where_to_put_meryl_databases"] + "/{szDatasetName}.no_low_freq_kmers.meryl", szDatasetName = aGetAllDatasetNames()  )


rule remove_low_occurrence_kmers:
	input:  config["where_to_put_meryl_databases"] + "/{szDatasetName}_genomescope/summary.txt"
	output: directory( config["where_to_put_meryl_databases"] + "/{szDatasetName,[^.]+}.no_low_freq_kmers.meryl" )
	resources:
		threads=40,
		mem=100
	run:
		nErrrorKmersCutoff = -666
		with open( input[0], "r" ) as fSummaryFile:
			for szLine in fSummaryFile.readlines():
				if (szLine.startswith( "Errror Kmers Cutoff" ) ):
					aWords = szLine.split()
					# looks like:
					# Errror Kmers Cutoff 7
					# 0      1     2     3
					nErrrorKmersCutoff = int( aWords[3] )
					break

		assert( nErrrorKmersCutoff != -666 )

		szCommand = "module load meryl/1.4.1 && meryl output {output}.tmp" + \
			f" [ greater-than {nErrrorKmersCutoff} " + config["where_to_put_meryl_databases"] + "/{wildcards.szDatasetName}.meryl" + " ] && mv {output}.tmp {output}"
		print( "about to execute: " + szCommand )
		shell( szCommand )


rule make_errror_cutoff:
	input: config["where_to_put_meryl_databases"] + "/{szDatasetName}.histogram"
	output: config["where_to_put_meryl_databases"] + "/{szDatasetName}_genomescope/summary.txt"
	localrule: True
	run:
		szCommand = "module load R/4.4.0-openblas-rocky8 && Rscript genomescope_vertical_line.R " + config["where_to_put_meryl_databases"] + "/{wildcards.szDatasetName}.histogram 21 150 " + config["where_to_put_meryl_databases"] + "/{wildcards.szDatasetName}_genomescope"
		print( "about to execute: " + szCommand )
		shell( szCommand )

# is this fast enough to be a localrule?
rule make_histogram_for_one_dataset:
	input: config["where_to_put_meryl_databases"] + "/{szDatasetName}.meryl"
	output: config["where_to_put_meryl_databases"] + "/{szDatasetName}.histogram"
	localrule: True
	run:
		szCommand = f"module load meryl/1.4.1 && meryl histogram {input} >{output}.tmp"
		print( "about to execute: " + szCommand )
		shell( szCommand )

		szCommand = f"./convertMerylHistogramToJellyfishHistogram.py --szInputMerylHistogram {output}.tmp --szOutputJellyfishHistogram {output} && rm {output}.tmp"
		print( "about to execute: " + szCommand )
		shell( szCommand )



rule make_meryl_database_for_one_dataset:
	input: szGetShortReadDataSetByDatasetName
	output: directory( config["where_to_put_meryl_databases"] + "/{szDatasetName,[^.]+}.meryl" )	
	resources:
		threads=40,
		mem=100
	run:
		# debugging
		print( "trying to generate " + str( output ) + " using input " + str( input ) )
		# end debugging


		szTemporaryMerylDatabaseName = str( output ) + ".almost_done"

		szCommand = f"module load meryl/1.4.1 && meryl count k=21 {input} output " + szTemporaryMerylDatabaseName
		print( "about to execute: " + szCommand )
		shell( szCommand )
		szCommand = f"mv {szTemporaryMerylDatabaseName} {{output}}"
		print( "about to execute: " + szCommand )
		shell( szCommand )


