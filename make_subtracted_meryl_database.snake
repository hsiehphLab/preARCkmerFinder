rule subtract_find_minus_remove:
        output: directory( config["where_to_put_meryl_databases"] + "/{szArchaic}_minus_{szMultipleAfricans}.meryl" )
        resources:
                threads=40,
                mem=100
        run:
                szArchaic = str( wildcards.szArchaic )
                szMultipleAfricans = str( wildcards.szMultipleAfricans )
                szArchaicFullPath = szGetArchaicFullPath( szArchaic )
                print( f"archaic: {szArchaicFullPath}" )

                aWords = szMultipleAfricans.split( '_' )
                aAfricanFullPath = []
                for szWord in aWords:
                    szAfricanFullPath = szGetAfricanFullPath( szWord )
                    aAfricanFullPath.append( szAfricanFullPath )
                    print( f"African: {szAfricanFullPath}" )
                print( f"trying to create {output}" )

                szJustSomethingUnique = f"{wildcards.szArchaic}_minus_{wildcards.szMultipleAfricans}"
                nIntermediateFile = 0
                for szMerylDatabaseToRemove in aAfricanFullPath:
                        nIntermediateFile += 1
                        if ( nIntermediateFile == 1 ):
                            szIntermediateMerylDatabase = szArchaicFullPath

                        szNextIntermediateMerylDatabase = szJustSomethingUnique + "_intermediate" + str( nIntermediateFile ) + ".meryl"
                        szCommand = "module load meryl/1.4.1 && meryl difference threads=40 " + szIntermediateMerylDatabase + " " + szMerylDatabaseToRemove + " output " + szNextIntermediateMerylDatabase
                        print( "about to execute: " + szCommand )
                        shell( szCommand )

                        # delete previous intermediate meryl database--we won't need it again
                        if ( nIntermediateFile > 1 ):
                            szCommand = f"rm -rf {szIntermediateMerylDatabase}"
                            print( "about to execute: " + szCommand )
                            shell( szCommand )

                        szIntermediateMerylDatabase = szNextIntermediateMerylDatabase

                # for szMerylDatabaseToRemove in aAfricanFullPath:

                        
                # how many kmers are left here--no!  don't do this!  it will take forever!
                # szCommand = "module load meryl/1.4.1 && meryl print " + szIntermediateMerylDatabase + "| wc -l >" + szIntermediateMerylDatabase + ".unique_kmers"
                # print( "about to execute: " + szCommand )
                # shell( szCommand )


                # when get to here, the result is in szIntermediateMerylDatabase
                # let's just rename that to the output
                szCommand = "mv " + szIntermediateMerylDatabase + " " + str( output )
                print( "about to execute: " + szCommand )
                shell( szCommand )

                # while we are here, let's create a histogram and count kmers
                szHistogram = re.sub( r'\.meryl', r'\.histogram', str( output ) )
                szCommand = "module load meryl/1.4.1 && meryl histogram " + str( output ) + f" >{szHistogram}"
                print( "about to execute: " + szCommand )
                shell( szCommand )


                szNumberOfKmers = re.sub( r'\.meryl', r'\.sumOfKmers', str( output ) )
                szCommand = "cat " + szHistogram + " | awk '{{x += $2}} END {{print x }}' | numfmt --grouping >" + szNumberOfKmers
                print( "about to execute: " + szCommand )
                shell( szCommand )

                
