import sys
import os
import re
import glob

# note: errror is deliberately misspelled to enable easy searching for the real thing

configfile: "config.yaml"


def szGetArchaicFullPath( szArchaic ):

    return szGetFullPath( config["where_to_find_archaic_meryl_databases"], szArchaic )

def szGetAfricanFullPath( szAfrican ):

    return szGetFullPath( config["where_to_find_african_meryl_databases"], szAfrican )

def szGetFullPath( szWhereToFindDataset, szDatasetName ):

    szGlobPattern = szWhereToFindDataset + "/" + szDatasetName + ".no_*_freq_kmers.meryl"
    aFullPath = glob.glob( szGlobPattern )
    assert len( aFullPath ) == 1, f"glob.glob returned array with length {len( aFullPath ) } = {aFullPath} while using global pattern {szGlobPattern}"

    return aFullPath[0]


wildcard_constraints:
    # Restrict the value of {szDatasetName} to exclude periods globally
    szArchaic = "[^_.]+"




def aGetAllSubtractedDatabaseNames():
    aArchaics = []
    aAfricans = []
    szDataset = ""
    with open( config["manifest"], "r" ) as fManifest:
        for szLine in fManifest.readlines():
            # looks like:
            # dataset: (dataset)
            # archaic: Y/N
            # reads: (path to reads)
            szLine = szLine.rstrip()
            if ( szLine == "" ):
                continue
            if( szLine.startswith( "#" ) ):
                continue
            
            aWords = szLine.split()
            if ( aWords[0] == "dataset:" ):
                szDataset = aWords[1]
            elif( aWords[0] == "archaic:" ):
                assert szDataset != ""
                if ( aWords[1] == "Y" ):
                    aArchaics.append( szDataset )
                elif( aWords[1] == "N" ):
                    aAfricans.append( szDataset )
                else:
                    assert False

                szDataset = ""
    #with open( config["manifest"], "r" ) as fManifest:

    aSubtractedDatabase = []
    for szArchaic in aArchaics:
            szSubtractedDatabase = szArchaic + "_minus"
            for szAfrican in aAfricans:
                    szSubtractedDatabase += "_"
                    szSubtractedDatabase += szAfrican
            szSubtractedDatabase += ".meryl"
            aSubtractedDatabase.append( szSubtractedDatabase )

    print( "aSubtractedDatabase = ", aSubtractedDatabase )

    return aSubtractedDatabase
# def aGetAllSubtractedDatabaseNames():
                        


rule all:
	input: expand( config["where_to_put_meryl_databases"] + "/{szOneSubtractedDatabase}", szOneSubtractedDatabase = aGetAllSubtractedDatabaseNames() )


